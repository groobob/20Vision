<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="_20Vision.MainWindow"
        WindowState="FullScreen"
        Background="{x:Null}"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Title="20Vision">
    <Grid>
        <Border x:Name="alert"
                Background="#fc5656"
                Width="100"
                Height="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                CornerRadius="10"
                IsVisible="False">
            <TextBlock FontSize="100"
                       TextElement.Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">!
            </TextBlock>
        </Border>
        <Border x:Name="SettingsMenu"
                Background="#33333333"
                CornerRadius="10"
                Width="400"
                Height="500"
                BorderBrush="Black"
                BorderThickness="1">
            <Grid RowDefinitions="1.5*, 7.5*, 1*">
                <TextBlock Grid.Row="0"
                           FontSize="50"
                           Margin="10"
                           TextElement.Foreground="White"
                           HorizontalAlignment="Center">Settings
                </TextBlock>
                <Grid Grid.Row="1"
                      RowDefinitions="1* 1*">
                    <Border Background="#33000000"
                            CornerRadius="5"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            Grid.Row="0"
                            Margin="20, 0, 20, 10">
					    <Grid Grid.Row="0"
                              RowDefinitions="1*, 4*">
                            <TextBlock Grid.Row="0"
                                       FontSize="25"
                                       Margin="10"
                                       TextElement.Foreground="White"
                                       HorizontalAlignment="Center">Alert Display Frequency
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Border Background="#33000000"
                            CornerRadius="5"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            Grid.Row="1"
                            Margin="20, 10, 20, 0">
                        <Grid Grid.Row="0"
                              RowDefinitions="1*, 4*">
                            <TextBlock Grid.Row="0"
                                       FontSize="25"
                                       Margin="10"
                                       TextElement.Foreground="White"
                                       HorizontalAlignment="Center">Alert Display Duration
                            </TextBlock>
                        </Grid>
                    </Border>

                </Grid>
			    <Button Grid.Row="2"
                        Content="Back"
                        TextElement.Foreground="White"
                        Margin="10"
                        Background="#33000000"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Click="DisableSettingsMenu"/>
                <Button Grid.Row="2"
                        Content="Exit"
                        TextElement.Foreground="White"
                        Margin="10"
                        Background="#33000000"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Click="Exit"/>
            </Grid>
        </Border>
    </Grid>
</Window>
