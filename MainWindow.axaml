<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="_20Vision.MainWindow"
        WindowState="FullScreen"
        Background="{x:Null}"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Title="20Vision">
    <Grid>
        <Border x:Name="alert"
                Background="#fc5656"
                Width="100"
                Height="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                CornerRadius="10"
                IsVisible="False">
            <TextBlock FontSize="100"
                       TextElement.Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">!
            </TextBlock>
        </Border>
        <Border x:Name="SettingsMenu"
                Background="#33000000">
            <Border Background="#33333333"
                    CornerRadius="10"
                    Width="400"
                    Height="500"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="2">
                <Grid RowDefinitions="1.5*, 7.5*, 1*">
                    <TextBlock Grid.Row="0"
                               FontSize="50"
                               Margin="10"
                               TextElement.Foreground="White"
                               HorizontalAlignment="Center">Settings
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#33000000"
                                        CornerRadius="5"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1.5"
                                        Grid.Row="0"
                                        Margin="20, 0, 20, 10">
					                <Grid Grid.Row="0"
                                          RowDefinitions="1*, 4*">
                                        <TextBlock Grid.Row="0"
                                                   FontSize="25"
                                                   Margin="10"
                                                   TextElement.Foreground="White"
                                                   HorizontalAlignment="Center">Alert Display Frequency
                                        </TextBlock>
                                        <Grid Grid.Row="1"
                                              ColumnDefinitions="1*, 1*, 1*">
                                            <Button Background="#33000000"
                                                    FontSize="25"
                                                    Content="15min"
                                                    TextElement.Foreground="White"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Grid.Column="0"
                                                    Margin="10"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1.5"
                                                    CornerRadius="5"
                                                    x:Name="frequencySettingButton1"
                                                    />
                                            <Button Background="#33000000"
                                                    FontSize="25"
                                                    Content="20min"
                                                    TextElement.Foreground="White"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Grid.Column="1"
                                                    Margin="10"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1.5"  
                                                    CornerRadius="5"
                                                    x:Name="frequencySettingButton2"
                                                    />
                                            <Button Background="#33000000"
                                                    FontSize="25"
                                                    Content="30min"
                                                    TextElement.Foreground="White"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Grid.Column="2"
                                                    Margin="10"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1.5"  
                                                    CornerRadius="5"
                                                    x:Name="frequencySettingButton3"
                                                    />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Background="#33000000"
                                        CornerRadius="5"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1.5"
                                        Grid.Row="1"
                                        Margin="20, 0, 20, 10">
                                    <Grid Grid.Row="0"
                                          RowDefinitions="1*, 4*">
                                        <TextBlock Grid.Row="0"
                                                   FontSize="25"
                                                   Margin="10"
                                                   TextElement.Foreground="White"
                                                   HorizontalAlignment="Center">Alert Display Duration
                                        </TextBlock>
                                        <Grid Grid.Row="1"
                                              ColumnDefinitions="1*, 1*, 1*">
                                            <Button Background="#33000000"
                                                    FontSize="25"
                                                    Content="5sec"
                                                    TextElement.Foreground="White"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Grid.Column="0"
                                                    Margin="10"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1.5"
                                                    CornerRadius="5"
                                                    x:Name="durationSettingButton1"
                                                    />
                                            <Button Background="#33000000"
                                                    FontSize="25"
                                                    Content="10sec"
                                                    TextElement.Foreground="White"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Grid.Column="1"
                                                    Margin="10"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1.5"
                                                    CornerRadius="5"
                                                    x:Name="durationSettingButton2"
                                                    />
                                            <Button Background="#33000000"
                                                    FontSize="25"
                                                    Content="20sec"
                                                    TextElement.Foreground="White"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Grid.Column="2"
                                                    Margin="10"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1.5"
                                                    CornerRadius="5"
                                                    x:Name="durationSettingButton3"
                                                    />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <CheckBox x:Name="runOnStartUpCheck"
                                          FontSize="20"
                                          TextElement.Foreground="White"
                                          Content="Run app on startup"
                                          IsChecked="False"
                                          Margin="20, 0, 20, 10"/>
                                <CheckBox x:Name="displayAlertTimerCheck"
                                          FontSize="20"
                                          TextElement.Foreground="White"
                                          Content="Show display timer for alert"
                                          IsChecked="False"
                                          Margin="20, 0, 20, 10"/>
                                <CheckBox x:Name="intrusiveAlertCheck"
                                          FontSize="20"
                                          TextElement.Foreground="White"
                                          Content="Enable mildy intrusive alert"
                                          IsChecked="False"
                                          Margin="20, 0, 20, 10"/>
                                <CheckBox x:Name="buhCheck"
                                          FontSize="20"
                                          TextElement.Foreground="White"
                                          Content="buh??"
                                          IsChecked="False"
                                          Margin="20, 0, 20, 10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
			        <Button Grid.Row="2"
                            Content="Back"
                            TextElement.Foreground="White"
                            Margin="10"
                            Background="#33000000"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1.5"  
                            Click="DisableSettingsMenu"/>
                    <Button Grid.Row="2"
                            Content="Exit"
                            TextElement.Foreground="White"
                            Margin="10"
                            Background="#33000000"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1.5"  
                            Click="Exit"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
